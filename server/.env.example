# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# SQL Server. The instance name in the connection string is the one you chose
# during setup (SQLEXPRESS by default).
#
# Local, SQL auth:
DATABASE_URL="sqlserver://chatapp:YOUR_APP_PASSWORD@localhost:1433;database=chatapp;encrypt=true;trustServerCertificate=true"
#
# Azure / deployed, with a CA cert (see README "Deploying"):
# DATABASE_URL="sqlserver://USER:PASSWORD@HOST.database.windows.net:1433;database=chatapp;encrypt=true;trustServerCertificate=false"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Setup only. An admin connection string (the sa account, or Windows auth) used
# once by scripts/create-database.js to create the chatapp login and database.
# You can delete this line once the database exists.
# SQL_ADMIN_URL="sqlserver://sa:YOUR_SA_PASSWORD@localhost:1433;database=master;encrypt=true;trustServerCertificate=true"
